# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5433/maintenance_db?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# SAML SSO (configure for your IdP - Azure AD, Okta, etc.)
SAML_ENTRY_POINT=https://your-idp.example.com/sso/saml
SAML_ISSUER=maintenance-sso
SAML_CERT=your-idp-certificate-base64
SAML_PRIVATE_KEY=your-sp-private-key-base64
SAML_CALLBACK_URL=http://localhost:4000/auth/saml/callback

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@megamtx.local
SMTP_PASS=your-smtp-password
EMAIL_FROM_NAME=MegaMTX Maintenance
EMAIL_FROM_ADDRESS=maintenance@megamtx.local
EMAIL_REPLY_DOMAIN=megamtx.local
EMAIL_REPLY_LOCAL_PART=maintenance

# Email ingress (IMAP polling)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=maintenance@megamtx.local
IMAP_PASS=your-imap-app-password
IMAP_MAILBOX=INBOX
IMAP_POLLING_ENABLED=false
IMAP_POLL_INTERVAL_SECONDS=60
IMAP_MAX_MESSAGES_PER_POLL=50
DEFAULT_ORGANIZATION_ID=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15017122661
TWILIO_STATUS_CALLBACK_URL=https://your-domain.example.com/api/webhooks/twilio/sms-status

# PayPal billing (scaffolded; checkout/webhooks not active yet)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_ENVIRONMENT=sandbox

# SMS (Twilio) — leave blank to disable SMS notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15551234567

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# App settings
TICKET_NUMBER_PREFIX=MNT
COMPANY_NAME=MegaMTX
