# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5433/maintenance_db?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# SAML SSO (configure for your IdP - Azure AD, Okta, etc.)
SAML_ENTRY_POINT=https://your-idp.example.com/sso/saml
SAML_ISSUER=maintenance-sso
SAML_CERT=your-idp-certificate-base64
SAML_PRIVATE_KEY=your-sp-private-key-base64
SAML_CALLBACK_URL=http://localhost:4000/auth/saml/callback

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@megamtx.local
SMTP_PASS=your-smtp-password
EMAIL_FROM_NAME=MegaMTX Maintenance
EMAIL_FROM_ADDRESS=maintenance@megamtx.local
EMAIL_REPLY_DOMAIN=megamtx.local
EMAIL_REPLY_LOCAL_PART=maintenance

# Email ingress (IMAP polling)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=maintenance@megamtx.local
IMAP_PASS=your-imap-app-password
IMAP_MAILBOX=INBOX
IMAP_POLLING_ENABLED=false
IMAP_POLL_INTERVAL_SECONDS=60
IMAP_MAX_MESSAGES_PER_POLL=50
DEFAULT_ORGANIZATION_ID=

# Push Notifications (Firebase Cloud Messaging)
# Option A: Provide individual service account fields
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Option B: Provide the full service account JSON as a single env var (base64 or raw JSON)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# PayPal billing (scaffolded; checkout/webhooks not active yet)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_ENVIRONMENT=sandbox

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# App settings
TICKET_NUMBER_PREFIX=MNT
COMPANY_NAME=MegaMTX
